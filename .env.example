# Postgres connection used by the backend (docker-compose sets this automatically for the backend service)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/carolleonidas

# Secret used to sign admin JWTs — set a strong random value in production
JWT_SECRET=change-me-in-production

# Seed admin credentials, created on first backend boot if not already present
ADMIN_SEED_EMAIL=carol.leonidas@gmail.com
ADMIN_SEED_PASSWORD=Admin@CL2026
